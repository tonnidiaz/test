{
    "name": "tu-trader-worker",
    "version": "0.0.0",
    "private": true,
    "description": "Express app with typescript by Tu",
    "author": "Tonni Diaz",
    "type": "module",
    "scripts": {
        "cp": "copyfiles -u 1 ./src/views/**/* ./src/public/**/* ./src/assets/**/* ./dist",
        "build0": "rimraf dist && tsc --project tsconfig.json && tsc-alias -p tsconfig.json && npm run cp",
        "build": "rimraf dist && tsc && npm run cp",
        "esbuild": "rimraf dist && esbuild src/index.ts --bundle --platform=node --outfile=dist/bundle.js --resolve-extensions=.js,.ts && npm run cp",
        "start0": "node -r tsconfig-paths/register dist/src/index.js",
        "start": "node dist/src/index.js",
        "start:es": "node dist/bundle.js",
        "build:es": "rimraf dist && node esbuild.config.js && npm run cp",
        "dev": "tsx watch src/index.ts"
    },
    "dependencies": {
        "@repo/common": "^1.0.0",
        "@repo/typescript-config": "^0.0.0",
        "cookie-parser": "*",
        "cors": "*",
        "dotenv": "*",
        "express": "*",
        "fs": "^0.0.1-security",
        "http-errors": "*",
        "kucoin-api": "^1.0.20",
        "morgan": "*",
        "pug": "*"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.5.9",
        "@types/cookie-parser": "*",
        "@types/cors": "*",
        "@types/express": "*",
        "@types/node": "*",
        "esbuild-plugin-copy": "^2.1.1",
        "rimraf": "*",
        "tsc-alias": "^1.8.10",
        "tsconfig-paths": "^4.2.0",
        "tsx": "*",
        "typescript": "*"
    }
}
